# CSDF Assignment 6 - Custom SNORT rules
# Linux: copy to /etc/snort/rules/local.rules     Windows: C:\Snort\rules\local.rules
# Rule format: action protocol src_ip src_port -> dst_ip dst_port (options)

# 1. Detect ICMP ping to this machine
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping detected"; itype:8; sid:1000001; rev:1;)

# 2. Detect any Telnet connection attempt (insecure, cleartext)
alert tcp any any -> $HOME_NET 23 (msg:"Telnet connection attempt"; flags:S; sid:1000002; rev:1;)

# 3. Detect FTP login attempt and failed FTP login
alert tcp any any -> $HOME_NET 21 (msg:"FTP connection attempt"; flags:S; sid:1000003; rev:1;)
alert tcp $HOME_NET 21 -> any any (msg:"FTP failed login"; content:"530 "; sid:1000004; rev:1;)

# 4. Detect possible SSH brute force (5 SYNs to port 22 from same source in 60 s)
alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH brute force"; flags:S; detection_filter:track by_src, count 5, seconds 60; sid:1000005; rev:1;)

# 5. Detect Nmap SYN port scan (many SYNs in a short time)
alert tcp any any -> $HOME_NET any (msg:"Possible TCP SYN port scan"; flags:S; detection_filter:track by_src, count 20, seconds 5; sid:1000006; rev:1;)

# 6. Detect visits to a specific website (HTTP Host header)
alert tcp $HOME_NET any -> any 80 (msg:"Access to facebook.com"; content:"Host|3a| www.facebook.com"; nocase; sid:1000007; rev:1;)

# 7. Detect SQL injection attempt in HTTP traffic
alert tcp any any -> $HOME_NET 80 (msg:"SQL Injection attempt"; content:"' OR 1=1"; nocase; sid:1000008; rev:1;)
